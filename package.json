{
  "name": "rma_backend",
  "version": "1.0.0",
  "description": "RMA Application",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "test": "node --test",
    "syntax:check": "find src test -name '*.js' -print0 | xargs -0 -n1 node --check",
    "verify": "npm run prisma:validate && npm run syntax:check && npm test",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status"
  },
  "author": "kunj patel",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
