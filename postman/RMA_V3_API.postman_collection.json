  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "customerAccessToken", "value": "" },
    { "key": "organizationId", "value": "9001" },
    { "key": "organizationId2", "value": "9002" },
    { "key": "userId", "value": "9002" },
    { "key": "technicianId", "value": "9003" },
    { "key": "customerId", "value": "9401" },
    { "key": "customerId2", "value": "9402" },
    { "key": "productId", "value": "9201" },
    { "key": "serialId", "value": "9301" },
    { "key": "repairJobId", "value": "9102" },
    { "key": "repairCostId", "value": "9803" },
    { "key": "commentId", "value": "9901" },
    { "key": "notificationId", "value": "0" },
    { "key": "documentId", "value": "0" },
    { "key": "sessionId", "value": "0" },
    { "key": "activationToken", "value": "replace-with-token" },
    { "key": "resetToken", "value": "replace-with-token" }
