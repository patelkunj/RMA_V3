            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Alex\",\n  \"last_name\": \"Tester\",\n  \"email\": \"alex.tester@example.test\",\n  \"mobile\": \"+64 21 555 7777\",\n  \"role\": \"TECHNICIAN\",\n  \"assignedCustomer\": [{{customerId}}],\n  \"assignedOrg\": [{{organizationId}}]\n}"
            }
          }
        },
        {
          "name": "List Users",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/users" }
        },
        {
          "name": "List Users Legacy",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/users/list_user" }
        },
        {
