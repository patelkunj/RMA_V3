              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "Logout User",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/users/logout" }
