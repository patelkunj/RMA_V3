NODE_ENV=production
PORT=3000
TRUST_PROXY=true
SHUTDOWN_TIMEOUT_MS=10000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
LEGACY_API_DEPRECATION=Sat, 18 Jul 2026 00:00:00 GMT
LEGACY_API_SUNSET=Sun, 31 Jan 2027 00:00:00 GMT

# Database
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_HOST=host
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_NAME=database

# CORS
CORS_ORIGIN=https://your-frontend.example.com
APP_URL=https://your-api.example.com

# JWT
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=rma-backend
JWT_AUDIENCE=rma-api
EXPOSE_AUTH_TOKENS_IN_RESPONSE=false
AUTH_LOCK_MAX_FAILURES=5
DEVICE_DATA_ENCRYPTION_KEY=replace-with-a-dedicated-32-character-minimum-secret
WEBHOOK_ENCRYPTION_KEY=replace-with-another-dedicated-32-character-secret
MFA_ENCRYPTION_KEY=replace-with-a-third-dedicated-32-character-secret
MFA_ISSUER=RMA Service

# Rate limits
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MAX=30
RATE_LIMIT_STORE=postgres

# Logging
SERVICE_NAME=rma-backend
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_FILE=false
LOG_FILE_PATH=logs/app.log
METRICS_TOKEN=replace-with-a-long-random-monitoring-token

# Background processing
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
SLA_WORKER_ENABLED=true
SLA_POLL_INTERVAL_MS=60000
REQUIRE_QA_BEFORE_COMPLETION=true
MAINTENANCE_WORKER_ENABLED=true
MAINTENANCE_POLL_INTERVAL_MS=3600000
WEBHOOK_TIMEOUT_MS=10000

# Upload security (ClamAV daemon)
FILE_SCAN_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# Private object storage (S3 or an S3-compatible service). Production requires s3.
UPLOAD_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=your-private-rma-bucket
OBJECT_STORAGE_REGION=ap-southeast-2
# Leave endpoint empty for AWS S3; set it for an S3-compatible provider.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
# Prefer an instance/task/workload role. Static credentials are optional and must be set as a pair.
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Optional customer-managed KMS key; otherwise S3-managed AES-256 encryption is used.
OBJECT_STORAGE_KMS_KEY_ID=
# Used only when UPLOAD_STORAGE_PROVIDER=local outside production.
LOCAL_PRIVATE_UPLOAD_ROOT=var/private-uploads

# Email
EMAILUSER=your-email@example.com
EMAILPASSWORD=your-email-app-password
EMAIL_FROM=RMA Service <no-reply@example.com>
EMAIL_SERVICE=gmail
CUSTOMER_PORTAL_URL=https://your-customer-portal.example.com
PASSWORD_RESET_URL=https://your-customer-portal.example.com/reset-password

#Billing
TAX_RATE=0.15
INVOICE_CURRENCY=NZD
INVOICE_BANK_NAME=Your bank
INVOICE_ACCOUNT_NAME=Your account name
INVOICE_ACCOUNT_NUMBER=00-0000-0000000-00
INVOICE_SIGNATURE_NAME=RMA Service

# Test-only controls. TEST_DATABASE_URL must identify an isolated disposable database.
RUN_DB_INTEGRATION_TESTS=false
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/rma_test
# Optional HTTP integration tests bind temporary loopback servers.
RUN_HTTP_INTEGRATION_TESTS=false

# Opt-in load testing. Keep disabled in normal application environments.
RUN_LOAD_TESTS=false
LOAD_TEST_BASE_URL=http://127.0.0.1:3000
LOAD_TEST_PROFILE=health
LOAD_TEST_DURATION_SECONDS=15
LOAD_TEST_WARMUP_SECONDS=3
LOAD_TEST_CONCURRENCY=4
LOAD_TEST_RPS=10
LOAD_TEST_TIMEOUT_MS=5000
LOAD_TEST_MAX_ERROR_RATE=0.01
LOAD_TEST_MAX_5XX_RATE=0
LOAD_TEST_MAX_429_RATE=0
LOAD_TEST_MAX_P95_MS=500
LOAD_TEST_MAX_P99_MS=1000
LOAD_TEST_MIN_RPS=8
LOAD_TEST_REPORT_PATH=

# The authenticated-read profile needs either a dedicated token or test-user credentials.
LOAD_TEST_ACCESS_TOKEN=
LOAD_TEST_USER_EMAIL=
LOAD_TEST_USER_PASSWORD=
LOAD_TEST_MFA_CODE=

# Remote and high-intensity tests require separate explicit approvals.
LOAD_TEST_ALLOW_REMOTE=false
LOAD_TEST_CONFIRM_ORIGIN=
LOAD_TEST_ALLOW_HIGH_INTENSITY=false
