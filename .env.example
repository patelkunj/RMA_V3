NODE_ENV=production
PORT=3000
TRUST_PROXY=true

# Database
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_HOST=host
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_NAME=database

# CORS
CORS_ORIGIN=https://your-frontend.example.com
APP_URL=https://your-api.example.com

# JWT
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Rate limits
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MAX=30

# Logging
SERVICE_NAME=rma-backend
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_FILE=false
LOG_FILE_PATH=logs/app.log

# Email
EMAILUSER=your-email@example.com
EMAILPASSWORD=your-email-app-password
EMAIL_FROM=RMA Service <no-reply@example.com>
EMAIL_SERVICE=gmail
CUSTOMER_PORTAL_URL=https://your-customer-portal.example.com
PASSWORD_RESET_URL=https://your-customer-portal.example.com/reset-password

#Billing
TAX_RATE=0.15
INVOICE_CURRENCY=NZD
INVOICE_BANK_NAME=Your bank
INVOICE_ACCOUNT_NAME=Your account name
INVOICE_ACCOUNT_NUMBER=00-0000-0000000-00
INVOICE_SIGNATURE_NAME=RMA Service
